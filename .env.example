# ============================================================
# CivicConnect — Environment Variables
# Copy to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# Backend API base URL
# In development: Vite proxies /api to http://localhost:5177
# In production: Firebase Hosting rewrites /api/** to Cloud Function 'api'
VITE_API_URL=/api

# ────────────────────────────────────────────────────────────
# Firebase Configuration (Authentication + Hosting only)
# DO NOT remove these — Firebase Auth is the identity provider.
# ────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ────────────────────────────────────────────────────────────
# Supabase Configuration (Application Database — PostgreSQL)
# VITE_SUPABASE_URL: Your Supabase project URL
#   e.g. https://xyzxyzxyz.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY: The anon/publishable key (safe for browser)
#   Found in: Supabase Dashboard → Settings → API → Project API keys → anon (public)
#
# NEVER put SUPABASE_SERVICE_ROLE_KEY in a VITE_* variable.
# The service-role key belongs ONLY in server-side environment variables.
# ────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ────────────────────────────────────────────────────────────
# Backend-only (server/functions — NEVER expose via VITE_*)
# Set these in your deployment environment or local .env.local
# ────────────────────────────────────────────────────────────
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# FIREBASE_PROJECT_ID=civic-b6108
# GEMINI_API_KEY=
